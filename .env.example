# PKU Study local runtime. Copy to .env and source it before starting the CLI
# or server: set -a; source .env; set +a

# Keep application state inside this checkout only for development.
PKU_STUDY_DATA_DIR=.pku-study/data
PKU_STUDY_CONFIG_DIR=.pku-study/config
PKU_STUDY_CACHE_DIR=.pku-study/cache
PKU_STUDY_COURSES_DIR=.pku-study/courses

# Local API and Vite development server.
PKU_STUDY_HOST=127.0.0.1
PKU_STUDY_PORT=4317

# Teaching-network integration. Install pku3b >=0.16.0 <0.17.0 on PATH,
# then initialize the derived config path with:
# pku3b --config .pku-study/config/pku3b/config.toml init

# Optional Treehole endpoint/session. Leave authorization empty for Web login.
PKU_STUDY_TREEHOLE_BASE_URL=https://treehole.pku.edu.cn
# PKU_STUDY_TREEHOLE_AUTHORIZATION=

# Optional OpenAI-compatible providers. Keep secrets out of this file.
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PDF export engine. Use xelatex, tectonic, or another compatible executable.
PKU_STUDY_PDF_ENGINE=xelatex
# Optional override for the detected Chinese font (must be installed locally).
# PKU_STUDY_PDF_CJK_FONT=WenQuanYi Zen Hei

# PDF material parsing uses the zero-dependency MinerU-Skill cloud CLI.
# Set this to an absolute path when `mineru` is not on PATH. No local models are used.
# PKU_STUDY_MINERU_COMMAND=.pku-study/tools/bin/mineru
# MinerU-Skill 3.3.1 bypasses proxies in its default transport. If a proxy is required:
# PKU_STUDY_MINERU_COMMAND=/absolute/path/to/pku-agent/scripts/mineru-cloud.py
# PKU_STUDY_MINERU_SCRIPT=/absolute/path/to/mineru-skill/scripts/mineru.py
# Optional PDF splitting (requires pypdf in the MinerU Python environment).
# PKU_STUDY_MINERU_SPLIT=1

# Course discovery/resources use the structured Blackboard reader by default.
# Set 0 to use the legacy pku3b CLI adapter for troubleshooting.
# PKU_STUDY_STRUCTURED_TEACHING=0

# Explicit Agent model selection. An external Pi auth file is read without copying keys.
# PKU_STUDY_AGENT_PROVIDER=zai
# PKU_STUDY_AGENT_MODEL=glm-5.3-flash
# PKU_STUDY_PI_AUTH_PATH=/absolute/path/to/.pi/agent/auth.json
# PKU_STUDY_PI_MODELS_PATH=/absolute/path/to/.pi/agent/models.json
