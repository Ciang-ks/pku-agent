    "test": "node ../../scripts/run-vitest.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@pku-study/core": "workspace:*",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
