{
  "name": "pku-study",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, Pi-powered learning workspace for PKU courses.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <26",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "dev": "pnpm --filter @pku-study/server dev",
    "dev:web": "pnpm --filter @pku-study/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
